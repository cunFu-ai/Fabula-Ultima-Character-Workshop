# 可选：源码开发模式下的默认 LLM 设置。也可以直接在网页设置中填写。
FU_GM_API_BASE_URL=https://api.deepseek.com
FU_GM_API_KEY=
FU_GM_ACTION_MODEL=deepseek-v4-flash-vision-exp
FU_GM_PORTRAIT_PROMPT_MODEL=deepseek-v4-flash-vision-exp

# 可选：源码开发模式下的本机 ComfyUI 设置。
FU_GM_COMFYUI_BASE_URL=http://127.0.0.1:8188
FU_CHARACTER_WORKSHOP_WORKFLOW_ROOT=config/comfyui_workflows

# 只有自行配置访问控制后，才应允许连接非本机 ComfyUI。
FU_GM_COMFYUI_ALLOW_REMOTE=0
